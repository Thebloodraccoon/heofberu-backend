# Copy to .env (local) / .env.dev / .env.prod. Never commit real values.

# dev | test | staging | prod. Deployed images set REQUIRE_EXPLICIT_STAGE=true: STAGE is then mandatory
# (a missing value would otherwise silently start as "dev").
STAGE=dev

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
# Postgres max_connections (docker-compose.yml) — the pool budget below is validated against it.
# DB_MAX_CONNECTIONS=100

DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name
# With the compose Redis password set: redis://:your_redis_password@heof-redis:6379/0
REDIS_URL=redis://your_redis_host:6379/0
# REDIS_PASSWORD=your_redis_password

# JWT. staging/prod refuse to start with a placeholder or a secret shorter than 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256

# Default admin: ADMIN_LOGIN is used by the app (protected account); the three ADMIN_* values are read
# by migration 0003 when it seeds that account.
ADMIN_NAME=your_admin_name
ADMIN_LOGIN=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Browser origins allowed by CORS (scheme + host[+port], no path, no wildcard) and hostnames accepted in
# the Host header (bare names, no scheme). Both comma separated and REQUIRED for staging/prod;
# dev/test default to "*". Example: CORS_ORIGINS=https://app.example.com  ALLOWED_HOSTS=api.example.com
# CORS_ORIGINS=https://app.example.com
# ALLOWED_HOSTS=api.example.com

# Reverse proxies uvicorn trusts for X-Forwarded-For (IPs/CIDRs, comma separated, or *). Without the proxy
# listed here, rate limiting sees every client as the proxy.
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Supabase file storage
SUPABASE_URL=your_url
SUPABASE_KEY=your_token
STORAGE_BUCKET=your_storage

# Email (SMTP) — required for the password-reset mailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Heofberu <no-reply@example.com>"
# TLS mode: explicit (implicit) TLS for port 465 -> SMTP_USE_TLS=true, SMTP_STARTTLS=false
# STARTTLS for port 587 (e.g. smtp.resend.com) -> SMTP_USE_TLS=false, SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_STARTTLS=true
# Frontend page the password-reset email links to (the token is appended as ?token=...)
# FRONTEND_RESET_URL=https://app.example.com/reset-password

# Cache (defaults shown). CACHE_VERSION (e.g. a release id) is appended to the key prefix so a deploy that
# changes cached payload shapes never reads old entries.
# CACHE_ENABLED=true
# CACHE_TTL_DEFAULT=86400
# CACHE_PREFIX=cache
# CACHE_VERSION=
# CACHE_INDEX_MAX_KEYS=50000

# DB pool, per worker. Stage defaults apply when unset (prod: 4 workers x (5 + 5)); staging/prod validate
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) <= DB_MAX_CONNECTIONS - 10 at startup.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# WEB_CONCURRENCY=4
# DB_COMMAND_TIMEOUT_SECONDS=60

# Container: set RUN_MIGRATIONS=false on replicas that must not run `alembic upgrade head` at startup.
# RUN_MIGRATIONS=true

# Test (optional, only required when STAGE=test)
# Matches the heof-test-db / heof-test-redis services in docker-compose.dev.yml
# TEST_DATABASE_URL=postgresql://heof_user:test_secret@localhost:5433/heof_test_db
# TEST_REDIS_URL=redis://localhost:6381/0
