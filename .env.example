# STAGE
STAGE=local

# Postgres & Redis URLs
DATABASE_URL=postgresql://slavbor_user:your_password@slavbor_db:5432/slavbor_db
REDIS_URL=redis://slavbor_redis:6379/0

# JWT
JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=your_algorithm

# Admin credo
ADMIN_NAME=your_admin_name
ADMIN_LOGIN=your_admin_mail
ADMIN_PASSWORD=your_admin_password